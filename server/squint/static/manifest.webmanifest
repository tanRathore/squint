{
  "name": "squint",
  "short_name": "squint",
  "description": "Press, feel the answer. Is this AI?",
  "start_url": "/try",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "icons": [
    {"src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"}
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{"name": "file", "accept": ["image/*", "video/*", "audio/*"]}]
    }
  }
}
