SQUINT_DB_URL=sqlite:///./squint.db
SQUINT_SALT=change-me-before-anyone-uses-this
SQUINT_KEEP_MEDIA=false
SQUINT_MAX_UPLOAD_MB=25
SQUINT_RETENTION_DAYS=30

# detector providers, all optional, the server runs without any of them
SQUINT_HIVE_KEY=
SQUINT_SIGHTENGINE_USER=
SQUINT_SIGHTENGINE_SECRET=
SQUINT_REALITY_DEFENDER_KEY=
SQUINT_GPTZERO_KEY=
SQUINT_FACTCHECK_KEY=

# local onnx model exported from research/train.py
SQUINT_LOCAL_MODEL=

# comma separated keys for the partner api
SQUINT_PARTNER_KEYS=

# apple push for iphone watch mode (pip install -e ".[push]")
SQUINT_APNS_KEY=
SQUINT_APNS_KEY_ID=
SQUINT_APNS_TEAM_ID=
SQUINT_APNS_BUNDLE_ID=app.squint
SQUINT_APNS_SANDBOX=true

# bots
SQUINT_TELEGRAM_TOKEN=
SQUINT_WHATSAPP_TOKEN=
SQUINT_WHATSAPP_PHONE_ID=
SQUINT_WHATSAPP_VERIFY=squint
